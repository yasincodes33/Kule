# Kule backend — ortam değişkeni şablonu.
#
# Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` sürüm kontrolüne alınmaz.
# Yerel geliştirmede `local` profili (src/main/resources/application-local.properties) zaten
# çalışan varsayılanlar taşır; bu şablon asıl olarak konteyner / sunucu dağıtımı içindir:
#
#   docker run --env-file .env -p 8081:8081 kule-backend:0.1.0

# ---------------------------------------------------------------------------
# ZORUNLU — bunlar verilmezse uygulama başlangıçta hata verir
# ---------------------------------------------------------------------------
# HS256 imzalama anahtarı. Base64 ve en az 256 bit (32 byte) olmalı:
#   openssl rand -base64 32
JWT_SECRET=

# Saklanan agent API anahtarlarının (Claude / ChatGPT / Gemini) şifrelenmesinde kullanılır.
# Aynı biçim: base64, en az 32 byte. VAULT_ENABLED=true ise kullanılmaz.
API_KEY_SECRET=

# ---------------------------------------------------------------------------
# Veritabanı ve altyapı
# ---------------------------------------------------------------------------
DB_USERNAME=agentsaas
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------------------------------------------------------------
# Web / istemci
# ---------------------------------------------------------------------------
# Şifre sıfırlama ve davet e-postalarındaki bağlantılar bu adrese göre üretilir.
FRONTEND_BASE_URL=http://localhost:5173
# Virgülle ayrılmış origin listesi (CORS ve WebSocket handshake için aynı liste kullanılır).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# HTTPS olmayan bir ortamda refresh cookie'si gönderilmez; üretimde her zaman true kalmalı.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# E-posta (SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=kule@example.com

# ---------------------------------------------------------------------------
# Oturum ve hız sınırlama
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_MAX_REQUESTS=20
# X-Forwarded-For header'ına güvenilecek proxy/LB IP'leri. Boş bırakılırsa header yok sayılır.
AUTH_RATE_LIMIT_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# HashiCorp Vault (opsiyonel) — API anahtarı şifrelemesini Transit engine'e devreder
# ---------------------------------------------------------------------------
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_TRANSIT_KEY_NAME=agentsaas-api-keys

# ---------------------------------------------------------------------------
# Model adları (sağlayıcı yeni sürüm yayınladığında güncellenir)
# ---------------------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_BUDGET_MODEL=claude-haiku-4-5
CLAUDE_REASONING_MODEL=claude-opus-4-8
CHATGPT_MODEL=gpt-5.4
CHATGPT_BUDGET_MODEL=gpt-5.4-nano
CHATGPT_REASONING_MODEL=o4-mini
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FREE_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
